# /etc/caddy/Caddyfile on the server (ssh iasaki). One block per site.
# Until iasaki.top's ICP filing is approved, the Asaki site is served on the IP over plain HTTP.
# After approval, replace ":80" with "iasaki.top, www.iasaki.top": Caddy then gets and renews
# the HTTPS certificates itself, and sends http:// to https://.

:80 {
	root * /srv/asaki
	encode gzip
	file_server

	# Sparkle reads the list of versions: always check for a new one.
	header /appcast.xml Cache-Control "no-cache"
	# A DMG never changes once released.
	header /downloads/* Cache-Control "public, max-age=31536000, immutable"
}
